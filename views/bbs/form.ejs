<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/stylesheets/bbs.css" rel="stylesheet">
    <title>글 작성</title>
    <script>
        var CONTENT_MAX_BYTES = 4000;
        var FILE_MAX_BYTES = 10 * 1024 * 1024;

        function getByteLength(value) {
            return new Blob([value || '']).size;
        }

        function updateContentCounter() {
            var textarea = document.forms.form1.brdmemo;
            var counter = document.getElementById('contentCounter');
            var byteLength = getByteLength(textarea.value);
            counter.textContent = textarea.value.length + ' / ' + CONTENT_MAX_BYTES;
            counter.className = byteLength > CONTENT_MAX_BYTES ? 'bbs-counter bbs-danger-text' : 'bbs-counter';
        }

        function validateForm() {
            var title = document.forms.form1.brdtitle.value.trim();
            var content = document.forms.form1.brdmemo.value.trim();
            var file = document.forms.form1.userfile.files[0];

            if (!title || !content) {
                alert('제목과 내용을 모두 입력하세요.');
                return false;
            }
            if (file && file.size > FILE_MAX_BYTES) {
                alert('첨부파일은 10MB 이하만 업로드할 수 있습니다.');
                return false;
            }
            if (getByteLength(document.forms.form1.brdmemo.value) > CONTENT_MAX_BYTES) {
                alert('글 내용이 4000바이트를 초과했습니다. 내용을 줄여주세요.');
                return false;
            }
            return true;
        }

        window.onload = updateContentCounter;
    </script>
</head>
<body class="bbs-dashboard">
    <main class="bbs-shell">
        <section class="bbs-card bbs-form">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h1 class="h3 bbs-page-title">글 작성</h1>
                    <p class="bbs-muted mb-0">게시판에 새 글을 등록합니다.</p>
                </div>
                <a href="/bbs/list" class="btn btn-outline-secondary">목록</a>
            </div>

            <form name="form1" action="/bbs/save" method="post" enctype="multipart/form-data" onsubmit="return validateForm()">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">작성자</label>
                    <input type="text" class="form-control" name="brdwriter" maxlength="20" value="<%=id%>" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label">제목</label>
                    <input type="text" class="form-control" name="brdtitle" maxlength="250">
                </div>
                <div class="mb-3">
                    <label class="form-label">내용</label>
                    <textarea class="form-control" name="brdmemo" rows="10" oninput="updateContentCounter()"></textarea>
                    <div id="contentCounter" class="bbs-counter mt-2">0 / 4000</div>
                </div>
                <div class="mb-4">
                    <label class="form-label">파일 업로드</label>
                    <input type="file" class="form-control" name="userfile" accept=".txt,.pdf,.png,.jpg,.jpeg">
                    <div class="form-text">TXT(UTF-8), PDF, PNG, JPG 파일을 최대 10MB까지 첨부할 수 있습니다.</div>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="/bbs/list" class="btn btn-outline-secondary">취소</a>
                    <button type="submit" class="btn btn-primary">저장</button>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
