<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/stylesheets/bbs.css" rel="stylesheet">
    <title>회원가입</title>
    <script>
        var checkedId = '';
        var idAvailable = false;

        function resetIdCheck() {
            checkedId = '';
            idAvailable = false;
            var result = document.getElementById('idCheckResult');
            result.textContent = '아이디 중복 확인을 해주세요.';
            result.className = 'form-text';
        }

        function checkIdDuplicate() {
            var id = document.form1.id.value.trim();
            var result = document.getElementById('idCheckResult');

            if (id.length < 4 || id.length > 20) {
                result.textContent = '아이디는 4~20자로 입력하세요.';
                result.className = 'form-text text-danger';
                checkedId = '';
                idAvailable = false;
                return;
            }

            fetch('/bbs/checkid?id=' + encodeURIComponent(id))
                .then(function(response) { return response.json(); })
                .then(function(data) {
                    result.textContent = data.message;
                    result.className = data.available ? 'form-text text-success' : 'form-text text-danger';
                    checkedId = data.available ? id : '';
                    idAvailable = data.available;
                })
                .catch(function() {
                    result.textContent = '아이디 확인 중 오류가 발생했습니다.';
                    result.className = 'form-text text-danger';
                    checkedId = '';
                    idAvailable = false;
                });
        }

        function validateSignup() {
            var form = document.form1;
            var id = form.id.value.trim();
            var pw1 = form.pw1.value;
            var pw2 = form.pw2.value;
            var name = form.name.value.trim();
            var email = form.email.value.trim();

            if (!id || !pw1 || !pw2 || !name || !email) {
                alert('모든 필수 항목을 입력하세요.');
                return false;
            }
            if (!idAvailable || checkedId !== id) {
                alert('아이디 중복 확인을 해주세요.');
                return false;
            }
            if (id.length < 4 || id.length > 20) {
                alert('아이디는 4~20자로 입력하세요.');
                return false;
            }
            if (pw1.length < 6 || pw1.length > 20) {
                alert('비밀번호는 6~20자로 입력하세요.');
                return false;
            }
            if (pw1 !== pw2) {
                alert('비밀번호가 서로 다릅니다.');
                return false;
            }
            return true;
        }
    </script>
</head>
<body class="bbs-dashboard">
    <% if(code == 1) { %> <script>alert('이미 로그인되어 있습니다.'); location.href='/bbs/list';</script> <% } %>

    <main class="bbs-shell">
        <section class="bbs-card bbs-auth">
            <div class="text-center mb-4">
                <div class="bbs-brand-mark mx-auto mb-3">B</div>
                <h1 class="h3 bbs-page-title">회원가입</h1>
                <p class="bbs-muted mb-0">게시판에서 사용할 계정을 만드세요.</p>
            </div>

            <form name="form1" action="/bbs/signupsave" method="post" onsubmit="return validateSignup()">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">아이디</label>
                    <div class="input-group">
                        <input type="text" class="form-control" name="id" maxlength="20" oninput="resetIdCheck()">
                        <button type="button" class="btn btn-outline-primary" onclick="checkIdDuplicate()">중복 확인</button>
                    </div>
                    <div id="idCheckResult" class="form-text">아이디 중복 확인을 해주세요.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">비밀번호</label>
                    <input type="password" class="form-control" name="pw1" maxlength="20">
                </div>
                <div class="mb-3">
                    <label class="form-label">비밀번호 확인</label>
                    <input type="password" class="form-control" name="pw2" maxlength="20">
                </div>
                <div class="mb-3">
                    <label class="form-label">이름</label>
                    <input type="text" class="form-control" name="name" maxlength="20">
                </div>
                <div class="mb-4">
                    <label class="form-label">이메일</label>
                    <input type="email" class="form-control" name="email" maxlength="50">
                </div>
                <button type="submit" class="btn btn-primary w-100">회원가입</button>
            </form>

            <div class="text-center mt-3">
                <a href="/bbs/login" class="bbs-link small">이미 계정이 있으면 로그인</a>
            </div>
        </section>
    </main>
</body>
</html>
