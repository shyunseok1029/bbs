<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/stylesheets/bbs.css" rel="stylesheet">
    <title>회원 정보 수정</title>
</head>
<body class="bbs-dashboard">
    <%
        var column = rows[0];
    %>
    <main class="bbs-shell">
        <section class="bbs-card bbs-auth">
            <div class="text-center mb-4">
                <div class="bbs-brand-mark mx-auto mb-3">B</div>
                <h1 class="h3 bbs-page-title">회원 정보 수정</h1>
                <p class="bbs-muted mb-0">비밀번호는 변경할 때만 입력하세요.</p>
            </div>

            <form name="form1" action="/bbs/updatesignsave" method="post">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label class="form-label">아이디</label>
                    <input type="text" class="form-control" name="id" maxlength="20" value="<%=column[0]%>" readonly>
                </div>
                <div class="mb-3">
                    <label class="form-label">현재 비밀번호 (비밀번호 변경 시)</label>
                    <input type="password" class="form-control" name="currentPassword" autocomplete="current-password">
                </div>
                <div class="mb-3">
                    <label class="form-label">새 비밀번호</label>
                    <input type="password" class="form-control" name="pw1" maxlength="20" placeholder="변경할 때만 입력">
                </div>
                <div class="mb-3">
                    <label class="form-label">새 비밀번호 확인</label>
                    <input type="password" class="form-control" name="pw2" maxlength="20" placeholder="변경할 때만 입력">
                </div>
                <div class="mb-3">
                    <label class="form-label">이름</label>
                    <input type="text" class="form-control" name="name" maxlength="20" value="<%=column[1]%>">
                </div>
                <div class="mb-4">
                    <label class="form-label">이메일</label>
                    <input type="email" class="form-control" name="email" maxlength="50" value="<%=column[2]%>">
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a href="/bbs/list" class="btn btn-outline-secondary">취소</a>
                    <button type="submit" class="btn btn-primary">정보 수정</button>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
