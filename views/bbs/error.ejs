<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/stylesheets/bbs.css" rel="stylesheet">
    <title>오류 메시지</title>
</head>
<body class="bbs-dashboard">
    <%
        var code = typeof errcode === 'undefined' ? 0 : errcode;
    %>

    <% if(code == 1) { %> <script>alert('패스워드가 다릅니다.'); history.back();</script> <% } %>
    <% if(code == 2) { %> <script>alert('id, 패스워드, 이름, 이메일은 공백일 수 없습니다.'); history.back();</script> <% } %>
    <% if(code == 3) { %> <script>alert('아이디가 중복되었습니다. 다시 가입하세요.'); history.back();</script> <% } %>
    <% if(code == 4) { %> <script>alert('로그인되어 있지 않습니다. 로그인부터 하세요.'); location.href='/bbs/list';</script> <% } %>
    <% if(code == 5) { %> <script>alert('댓글은 로그인 상태에서 입력 가능합니다. 로그인부터 하세요.'); location.href='/bbs/login';</script> <% } %>
    <% if(code == 6) { %> <script>alert('글 작성은 로그인 상태에서 가능합니다. 로그인부터 하세요.'); location.href='/bbs/login';</script> <% } %>
    <% if(code == 7) { %> <script>alert('작성자 본인만 수정하거나 삭제할 수 있습니다.'); location.href='/bbs/list';</script> <% } %>
    <% if(code == 8) { %> <script>alert('글 내용이 4000바이트를 초과했습니다. 내용을 줄여주세요.'); history.back();</script> <% } %>
    <% if(code == 9) { %> <script>alert('첨부파일은 10MB 이하만 업로드할 수 있습니다.'); history.back();</script> <% } %>
    <% if(code == 10) { %> <script>alert('제목과 내용을 모두 입력하세요.'); history.back();</script> <% } %>
    <% if(code == 11) { %> <script>alert('댓글 내용을 입력하세요.'); history.back();</script> <% } %>
    <% if(code == 12) { %> <script>alert('아이디는 4~20자, 비밀번호는 6~20자, 이메일은 올바른 형식으로 입력하세요.'); history.back();</script> <% } %>

    <% if(code == 0) { %>
        <main class="bbs-shell">
            <section class="bbs-card bbs-auth text-center">
                <div class="bbs-brand-mark mx-auto mb-3">!</div>
                <h1 class="h3 bbs-page-title">오류가 발생했습니다.</h1>
                <p class="bbs-muted"><%= typeof message === 'undefined' ? '요청을 처리하지 못했습니다.' : message %></p>
                <a href="/bbs/list" class="btn btn-primary">게시판 목록으로</a>
            </section>
        </main>
    <% } %>
</body>
</html>
