<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/stylesheets/bbs.css" rel="stylesheet">
    <title>게시판</title>
</head>
<body class="bbs-dashboard">
    <%
        var currentUserId = typeof userId === 'undefined' ? null : userId;
        var activeChoice = typeof searchChoice === 'undefined' ? '' : searchChoice;
        var activeKeyword = typeof searchKeyword === 'undefined' ? '' : searchKeyword;
        var activeSort = typeof sort === 'undefined' ? 'latest' : sort;
        var basePageUrl = activeKeyword
            ? '/bbs/search?choice=' + encodeURIComponent(activeChoice) + '&search=' + encodeURIComponent(activeKeyword) + '&sort=' + encodeURIComponent(activeSort)
            : '/bbs/list?sort=' + encodeURIComponent(activeSort) + '&';
        var pageParamPrefix = activeKeyword ? '&currentPage=' : 'currentPage=';
        var sortBaseUrl = activeKeyword
            ? '/bbs/search?choice=' + encodeURIComponent(activeChoice) + '&search=' + encodeURIComponent(activeKeyword) + '&sort='
            : '/bbs/list?sort=';
    %>

    <main class="bbs-app">
        <aside class="bbs-sidebar">
            <a href="/bbs/list" class="bbs-sidebar-brand">
                <span class="bbs-brand-mark">B</span>
                <span>BBS</span>
            </a>
            <nav class="bbs-nav">
                <a class="active" href="/bbs/list"><i class="bi bi-grid-fill"></i>게시판</a>
                <% if (currentUserId) { %>
                    <a href="/bbs/my"><i class="bi bi-person-circle"></i>내 활동</a>
                    <a href="/bbs/updatesignup"><i class="bi bi-gear"></i>정보수정</a>
                    <form method="post" action="/bbs/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="bbs-link"><i class="bi bi-box-arrow-right"></i>로그아웃</button></form>
                <% } else { %>
                    <a href="/bbs/login"><i class="bi bi-box-arrow-in-right"></i>로그인</a>
                    <a href="/bbs/signup"><i class="bi bi-person-plus"></i>회원가입</a>
                <% } %>
            </nav>
        </aside>

        <section class="bbs-main">
            <header class="bbs-hero">
                <div>
                    <div class="bbs-kicker">최근 게시글</div>
                    <h1>BBS 게시판</h1>
                    <p>총 <strong><%=totalRecords%></strong>개의 게시글을 확인하고 있어요.</p>
                </div>
                <div class="bbs-hero-actions">
                    <% if (currentUserId) { %>
                        <span class="bbs-user-pill"><i class="bi bi-person-circle"></i><%=currentUserId%>님</span>
                        <a href="/bbs/form" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i>글쓰기</a>
                    <% } else { %>
                        <a href="/bbs/login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i>로그인</a>
                    <% } %>
                </div>
            </header>

            <section class="bbs-panel">
                <div class="bbs-toolbar">
                    <form action="/bbs/search" class="bbs-search-row">
                        <input type="hidden" name="sort" value="<%=activeSort%>">
                        <div class="bbs-search-options">
                            <input type="radio" class="btn-check" name="choice" id="choice-title" value="TITLE" autocomplete="off" <% if(activeChoice === 'TITLE' || !activeChoice) { %>checked<% } %>>
                            <label class="btn btn-outline-primary btn-sm" for="choice-title">제목</label>

                            <input type="radio" class="btn-check" name="choice" id="choice-writer" value="WRITER" autocomplete="off" <% if(activeChoice === 'WRITER') { %>checked<% } %>>
                            <label class="btn btn-outline-primary btn-sm" for="choice-writer">작성자</label>

                            <input type="radio" class="btn-check" name="choice" id="choice-content" value="CONTENT" autocomplete="off" <% if(activeChoice === 'CONTENT') { %>checked<% } %>>
                            <label class="btn btn-outline-primary btn-sm" for="choice-content">내용</label>

                            <input type="radio" class="btn-check" name="choice" id="choice-title-content" value="TITLE_CONTENT" autocomplete="off" <% if(activeChoice === 'TITLE_CONTENT') { %>checked<% } %>>
                            <label class="btn btn-outline-primary btn-sm" for="choice-title-content">제목 + 내용</label>
                        </div>
                        <div class="bbs-search-box">
                            <i class="bi bi-search"></i>
                            <input type="text" name="search" value="<%=activeKeyword%>" placeholder="검색어를 입력하세요">
                            <button type="submit">검색</button>
                        </div>
                    </form>

                    <div class="bbs-sort-tabs">
                        <a class="<%=activeSort === 'latest' ? 'active' : ''%>" href="<%=sortBaseUrl%>latest">최신순</a>
                        <a class="<%=activeSort === 'views' ? 'active' : ''%>" href="<%=sortBaseUrl%>views">조회수순</a>
                        <a class="<%=activeSort === 'likes' ? 'active' : ''%>" href="<%=sortBaseUrl%>likes">좋아요순</a>
                    </div>
                </div>

                <div class="bbs-track-list">
                    <div class="bbs-track-head">
                        <span>#</span>
                        <span>제목</span>
                        <span>작성자</span>
                        <span>조회수</span>
                        <span>댓글</span>
                        <span>좋아요</span>
                        <span>날짜</span>
                    </div>

                    <%
                        for (var i = 0; i < data.rows.length; i++) {
                            var column = data.rows[i];
                            var displayNo = totalRecords - stNum - i;
                            var preview = column[3] || '';
                            if (preview.length > 74) preview = preview.substring(0, 74) + '...';
                    %>
                        <article class="bbs-track-row">
                            <form method="post" action="/bbs/read_count?brdno=<%=column[0]%>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="bbs-track-no"><%=displayNo%></button></form>
                            <div class="bbs-track-title">
                                <form method="post" action="/bbs/read_count?brdno=<%=column[0]%>" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="bbs-link"><%=column[1] || '(제목 없음)'%></button></form>
                                <span><%=preview%></span>
                            </div>
                            <span class="bbs-track-meta"><%=column[2]%></span>
                            <span class="bbs-track-stat"><i class="bi bi-eye"></i><%=column[6] || 0%></span>
                            <span class="bbs-track-stat"><i class="bi bi-chat-dots"></i><%=column[7] || 0%></span>
                            <span class="bbs-track-stat"><i class="bi bi-hand-thumbs-up"></i><%=column[8] || 0%></span>
                            <span class="bbs-track-date"><%=column[4]%></span>
                        </article>
                    <% } %>
                </div>

                <% if (data.rows.length === 0) { %>
                    <div class="bbs-empty">
                        <div class="fw-bold mb-1">게시글이 없습니다.</div>
                        <div class="small">검색어를 바꾸거나 새 글을 작성해보세요.</div>
                    </div>
                <% } %>

                <nav class="bbs-pagination d-flex justify-content-center" aria-label="게시글 페이지">
                    <ul class="pagination mb-0">
                        <% if (currentPage > firstPage) { %>
                            <li class="page-item"><a class="page-link" href="<%=basePageUrl + pageParamPrefix + (currentPage - 1)%>">이전</a></li>
                        <% } else { %>
                            <li class="page-item disabled"><span class="page-link">이전</span></li>
                        <% } %>

                        <% for (var page = firstPage; page <= lastPage; page++) { %>
                            <% if (page > totalPage) break; %>
                            <li class="page-item <% if (currentPage == page) { %>active<% } %>">
                                <a class="page-link" href="<%=basePageUrl + pageParamPrefix + page%>"><%=page%></a>
                            </li>
                        <% } %>

                        <% if (currentPage < totalPage) { %>
                            <li class="page-item"><a class="page-link" href="<%=basePageUrl + pageParamPrefix + (currentPage + 1)%>">다음</a></li>
                        <% } else { %>
                            <li class="page-item disabled"><span class="page-link">다음</span></li>
                        <% } %>
                    </ul>
                </nav>
            </section>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
